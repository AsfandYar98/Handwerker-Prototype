# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables. Everything is optional — the
# prototype runs without any of them (in-memory storage, no emails, Jitsi links).

# ── Demo mode ───────────────────────────────────────────────────────────────
# "false" turns off the "Prototyp-Version" footer line + noindex and lets notifications go to
# the company address from site.config.js. Leave unset while pitching.
NEXT_PUBLIC_DEMO_MODE=

# Public URL, used for links in emails (Vercel sets VERCEL_URL automatically).
NEXT_PUBLIC_SITE_URL=

# ── Admin dashboard (/admin) ────────────────────────────────────────────────
# Without it, demo mode uses the password "demo".
ADMIN_PASSWORD=
# Optional: separate secret for signing sessions/links (any long random string).
AUTH_SECRET=

# ── Storage: Upstash Redis ──────────────────────────────────────────────────
# Easiest: Vercel → Storage / Marketplace → Upstash for Redis → connect.
# That sets KV_REST_API_URL and KV_REST_API_TOKEN for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Email: Resend (resend.com) ──────────────────────────────────────────────
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend, e.g. "Badsanierung Berlin <termine@your-domain.de>".
# Without a verified domain, onboarding@resend.dev only delivers to your own Resend account email.
MAIL_FROM=
# Who at the company gets "new booking" emails (comma-separated). In demo mode
# this is the ONLY company-side recipient — put your own address here.
NOTIFY_EMAIL=

# ── Calendly (optional) ─────────────────────────────────────────────────────
# Event type link, e.g. https://calendly.com/your-company/video-beratung
# When set, "Video-Beratung" is booked through Calendly, which emails the
# confirmation + meeting link (Zoom/Meet/Teams) to both parties.
NEXT_PUBLIC_CALENDLY_URL=
# Personal access token (Calendly → Integrations → API & Webhooks) — lets the
# site read date/time/meeting link of each booking for the dashboard.
CALENDLY_TOKEN=
# Printed by `npm run calendly:webhook -- <url>`; syncs cancellations (paid plan).
CALENDLY_WEBHOOK_SIGNING_KEY=
